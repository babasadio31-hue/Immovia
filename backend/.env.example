# Exemple de fichier de configuration (.env.example)
# Copiez ce fichier en .env pour votre environnement local.
# NE JAMAIS COMMITER DE VRAIES CLÉS OU FICHIERS .env SUR GITHUB !

# Configuration Base de données (en local SQLite, en production Railway PostgreSQL)
DATABASE_URL=sqlite:///./immovia.db

# Sécurité JWT
SECRET_KEY=changez_cette_cle_secrete_en_production_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Identifiants du Super Administrateur par défaut
ADMIN_EMAIL=admin@immovi.com
ADMIN_PASSWORD=admin123

# Passerelle de paiement Moneroh (Axasara)
MONEROH_SECRET_KEY=votre_cle_api_moneroh_ici
